{
  "id": "rfc6749.authorization-code.reject-wrong-redirect-uri",
  "rfc": "RFC 6749 \u00a74.1.3",
  "status": "deferred",
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "body": {
      "grant_type": "authorization_code",
      "code": "{{code}}",
      "client_id": "client-a",
      "redirect_uri": "https://attacker.example/callback"
    }
  },
  "expect": {
    "status": 400,
    "claims": {
      "error": "invalid_grant"
    }
  },
  "note": "Requires live authorization setup and client registration to obtain a code with known PKCE and redirect properties; no executable endpoint setup exists yet."
}
