{
  "id": "rfc6749.client-auth.reject-wrong-secret",
  "rfc": "RFC 6749 §2.3.1",
  "status": "planned",
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "headers": { "authorization": "Basic Y2xpZW50LWNvbmY6d3Jvbmctc2VjcmV0" },
    "body": {
      "grant_type": "authorization_code",
      "code": "00000000-0000-0000-0000-000000000000",
      "redirect_uri": "https://client.example/callback",
      "code_verifier": "conformance-verifier-0123456789-abcdefghijklmnopqrstuvwxyz"
    }
  },
  "expect": {
    "status": 401,
    "headers": { "www-authenticate": "Basic realm=\"oauth2\", charset=\"UTF-8\"" },
    "claims": { "error": "invalid_client" }
  }
}
